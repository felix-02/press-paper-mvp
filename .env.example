# Copy to .env and fill in from Supabase → Project Settings → API.
# Without these, the app runs in offline demo mode (in-memory, presenter pre-logged-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: PostHog product analytics (free tier). Leave blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
